# MongoDB connection used by Mongoose and the app.
# Against `docker compose up mongo` exposed on localhost:27017:
MONGODB_URI="mongodb://localhost:27017/business_card"

PORT=3000
NODE_ENV=development

# Origins allowed to call the API from a browser (comma-separated), e.g. for the
# frontend dev server. Leave unset to reflect any request origin (fine for local dev).
# CORS_ORIGIN="http://localhost:5173"

# S3-compatible object storage (MinIO locally via docker compose; point at real AWS
# S3 in production by changing S3_ENDPOINT/region/credentials — the client code
# doesn't change).
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="business-card"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_FORCE_PATH_STYLE="true"
S3_PUBLIC_URL="http://localhost:9000/business-card"
