# MongoDB connection used by Mongoose and the app.
# Against `docker compose up mongo` exposed on localhost:27017:
MONGODB_URI="mongodb://localhost:27017/business_card"

PORT=3000
# Local dev default. Real deployments MUST set NODE_ENV=production — it also
# gates GraphQL introspection and the CORS fallback below.
NODE_ENV=development

# Shared secret gating every owner-only GraphQL mutation (updateProfile,
# createProject/updateProject/removeProject, createSkill/removeSkill,
# createExperience/removeExperience) and POST /uploads/:folder — send it as
# `Authorization: Bearer <ADMIN_TOKEN>`. Generate one with: openssl rand -hex 32
ADMIN_TOKEN="change-me"

# Origins allowed to call the API from a browser (comma-separated), e.g. for the
# frontend dev server. Leave unset to reflect any request origin in dev; in
# production an unset CORS_ORIGIN fails closed (no cross-origin browser requests).
# CORS_ORIGIN="http://localhost:5173"

# S3-compatible object storage (MinIO locally via docker compose; point at real AWS
# S3 in production by changing S3_ENDPOINT/region/credentials — the client code
# doesn't change).
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="business-card"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_FORCE_PATH_STYLE="true"
S3_PUBLIC_URL="http://localhost:9000/business-card"
