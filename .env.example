# Secrets for `docker compose up` — copy to `.env` (gitignored) and fill in real
# values before running against anything but a throwaway local instance.

# MongoDB root credentials (mongo service enforces auth; the api service's
# MONGODB_URI is built from these automatically in docker-compose.yml).
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=change-me

# MinIO root credentials — also reused as the api service's S3 access key/secret.
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change-me

# Shared secret gating owner-only GraphQL mutations and POST /uploads/:folder.
# Generate one with: openssl rand -hex 32
ADMIN_TOKEN=change-me
